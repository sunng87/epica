# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored — never commit it.

# DeepSeek:
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ZAI (Zhipu AI, China endpoint):
ZAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# EPICA_MODEL=deepseek-v4-flash

# Local llama.cpp router (used when no DeepSeek/ZAI key is set):
# EPICA_LLMACPP_HOST=127.0.0.1:8331
