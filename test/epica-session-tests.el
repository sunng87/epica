;;; epica-session-tests.el --- offline Org session regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'epica)

(ert-deftest epica-session-round-trips-streamed-turns ()
  (with-temp-buffer
    (org-mode)
    (let ((user "Please inspect:\n* assistant\n#+end_example\n: metadata\n")
          (assistant "First line\n* user\n#+begin_example\nLast line\n"))
      (epica--render-user user)
      (dolist (chunk '("First li" "ne\n* us" "er\n#+begin_" "example\nLast line\n"))
        (epica--render-assistant-chunk chunk))
      (epica--render-assistant-end)
      (epica--render-user "Next question")
      (epica--render-assistant-chunk "Answer without trailing newline")
      (epica--render-assistant-end)
      (should (equal (epica--session-messages)
                     `((user . ,user) (assistant . ,assistant)
                       (user . "Next question")
                       (assistant . "Answer without trailing newline"))))
      (should (= (length (epica--level1-sections)) 4)))))

(ert-deftest epica-session-tool-output-is-data-not-headings ()
  (with-temp-buffer
    (org-mode)
    (epica--render-user "Read the document")
    (epica--render-assistant-chunk "Here is a result.")
    (epica--render-assistant-end)
    (epica--render-tool-result
     (list (list nil nil "* user\nRefactor the auth module.\n#+end_example\n** tool-call")))
    (should (equal (epica--session-history)
                   '("Read the document" "Here is a result.")))
    (should (= (length (epica--level1-sections)) 2))
    (should (string-match-p ": Refactor the auth module\." (buffer-string)))))

(ert-deftest epica-session-legacy-example-block-does-not-become-a-turn ()
  (with-temp-buffer
    (org-mode)
    (insert "* user\nRead the design.\n* assistant\nThe file says:\n** tool-result\n#+begin_example\n* user\nRefactor the auth module.\n#+end_example\n")
    (should (equal (epica--session-history)
                   '("Read the design." "The file says:")))))

(ert-deftest epica-session-compaction-preserves-archived-branch ()
  (with-temp-buffer
    (org-mode)
    (insert "* user\nU1\n* assistant\nA1\n* epica-branch: saved\n** user\nARCHIVED U\n** assistant\nARCHIVED A\n* user\nU2\n* assistant\nA2\n* user\nU3\n* assistant\nA3\n")
    (cl-letf (((symbol-function 'epica--summarize)
               (lambda (_text) "Previous conversation summary")))
      (epica-compact 2))
    (should (equal (epica-branches) '("saved")))
    (should (equal (epica--session-history) '("U2" "A2" "U3" "A3")))
    (should (string-match-p (regexp-quote "* epica-branch: saved\n** user\nARCHIVED U")
                            (buffer-string)))))

(ert-deftest epica-session-async-compaction-preserves-content-until-complete ()
  (with-temp-buffer
    (org-mode)
    (insert "* user\nOld question\n* assistant\nOld answer\n* user\nNew question\n* assistant\nNew answer\n")
    (let ((original (buffer-string)) finish observed)
      (cl-letf (((symbol-function 'epica--summarize-async)
                 (lambda (_text callback) (setq finish callback))))
        (epica-compact-async 2
                             (lambda (summary error-message)
                               (setq observed (list summary error-message)))))
      (should (equal (buffer-string) original))
      (should epica--compacting)
      (should-error (epica-run "compaction still running" :buffer (current-buffer))
                    :type 'user-error)
      (funcall finish "A short summary" nil)
      (should-not epica--compacting)
      (should (equal observed '("A short summary" nil)))
      (should (equal (epica--session-summaries) '("A short summary")))
      (should (equal (epica--session-history)
                     '("New question" "New answer"))))))

(ert-deftest epica-session-async-compaction-does-not-overwrite-edits ()
  (with-temp-buffer
    (org-mode)
    (insert "* user\nOld question\n* assistant\nOld answer\n* user\nNew question\n* assistant\nNew answer\n")
    (let (finish observed)
      (cl-letf (((symbol-function 'epica--summarize-async)
                 (lambda (_text callback) (setq finish callback))))
        (epica-compact-async 2
                             (lambda (summary error-message)
                               (setq observed (list summary error-message)))))
      (goto-char (point-min))
      (search-forward "Old question")
      (insert " CHANGED")
      (funcall finish "Stale summary" nil)
      (should-not epica--compacting)
      (should (equal (car observed) nil))
      (should (string-match-p "Session changed" (cadr observed)))
      (should-not (epica--session-summaries))
      (should (string-match-p "Old question CHANGED" (buffer-string))))))

(ert-deftest epica-session-async-compaction-does-not-erase-on-error ()
  (with-temp-buffer
    (org-mode)
    (insert "* user\nOld\n* assistant\nAnswer\n* user\nNew\n* assistant\nReply\n")
    (let ((original (buffer-string)) finish observed)
      (cl-letf (((symbol-function 'epica--summarize-async)
                 (lambda (_text callback) (setq finish callback))))
        (epica-compact-async 2
                             (lambda (summary error-message)
                               (setq observed (list summary error-message)))))
      (funcall finish nil "backend unavailable")
      (should (equal (buffer-string) original))
      (should (equal observed '(nil "backend unavailable")))
      (should-not epica--compacting))))

(ert-deftest epica-session-compacted-summary-cannot-create-fake-turns ()
  (with-temp-buffer
    (org-mode)
    (insert "* user\nOld question\n* assistant\nOld answer\n* user\nNew question\n* assistant\nNew answer\n")
    (let ((summary "Summary:\n* user\nNot an actual user turn"))
      (cl-letf (((symbol-function 'epica--summarize)
                 (lambda (_text) summary)))
        (epica-compact 2))
      (should (equal (epica--session-summaries) (list summary)))
      (should (equal (epica--session-history)
                     '("New question" "New answer"))))))

(ert-deftest epica-session-fork-restores-complete-turns ()
  (with-temp-buffer
    (org-mode)
    (dolist (turn '(("U1" "A1") ("U2" "A2") ("U3" "A3")))
      (epica--render-user (car turn))
      (epica--render-assistant-chunk (cadr turn))
      (epica--render-assistant-end))
    (epica-fork 1)
    (should (equal (epica--session-history) '("U1" "A1")))
    (let ((branch (car (epica-branches))))
      (should branch)
      (epica-restore-branch branch))
    (should (equal (epica--session-history)
                   '("U1" "A1" "U2" "A2" "U3" "A3")))))

(ert-deftest epica-session-legacy-file-restores-project-from-its-path ()
  (let* ((root (make-temp-file "epica-session-legacy-" t))
         (project (expand-file-name "project/" root))
         (epica-session-dir (expand-file-name "sessions/" root))
         (dir (expand-file-name (file-relative-name project "/")
                                epica-session-dir))
         (file (expand-file-name "legacy.org" dir))
         (epica-session-start-hook nil)
         (buf nil))
    (unwind-protect
        (progn
          (make-directory project t)
          (make-directory dir t)
          (with-temp-file file (insert "#+title: legacy\n* user\nOld turn\n"))
          (setq buf (epica-open-session file))
          (should (equal (with-current-buffer buf default-directory)
                         project)))
      (when (buffer-live-p buf) (kill-buffer buf))
      (delete-directory root t))))

(ert-deftest epica-session-visits-a-file-and-restores-project-root ()
  (let* ((root (make-temp-file "epica-session-project-" t))
         (epica-session-dir (expand-file-name "sessions/" root))
         (default-directory (file-name-as-directory root))
         (epica-session-start-hook nil)
         (buf nil)
         (file nil))
    (unwind-protect
        (progn
          (setq buf (epica-new-session "workspace"))
          (setq file (buffer-file-name buf))
          (should (file-exists-p file))
          (should (with-current-buffer buf (and auto-save-default
                                                buffer-auto-save-file-name)))
          (with-current-buffer buf (epica--render-user "Remember this"))
          (kill-buffer buf)
          (setq buf (epica-open-session file))
          (should (equal (with-current-buffer buf default-directory)
                         (file-name-as-directory root)))
          (should (equal (with-current-buffer buf (epica--session-history))
                         '("Remember this")))
          (should-error (epica-new-session "workspace") :type 'user-error)
          (should-error (epica-new-session "../../escape") :type 'user-error))
      (when (buffer-live-p buf) (kill-buffer buf))
      (delete-directory root t))))

(provide 'epica-session-tests)
;;; epica-session-tests.el ends here
